DATABASE_URL=postgres://rustdesk:rustdesk@localhost:5432/rustdesk_cp
BIND_ADDR=127.0.0.1:8080
BOOTSTRAP_TOKEN=replace-with-a-long-random-secret
SESSION_TTL_HOURS=24
# Use true for HTTPS deployments. The loopback development default is false.
SESSION_COOKIE_SECURE=false
# Required in every non-development deployment. A 32-byte key encoded as 64
# hexadecimal characters; used only to encrypt TOTP enrollment secrets at rest.
TOTP_ENCRYPTION_KEY=
# Optional 32-byte Ed25519 seed, encoded as 64 hexadecimal characters. Keep
# this in a deployment secret store; without it credential renewal returns 503.
DEVICE_CREDENTIAL_SIGNING_KEY=
RUST_LOG=info,control_plane_api=debug
