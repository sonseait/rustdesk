# Copy to .env.managed. This file is loaded only by managed-* Make targets.
# This must be the CP API base URL. With the supplied Caddy route, retain
# the /api prefix because Caddy strips it before proxying to the CP API.
MANAGED_CP_URL=https://control.example.com/api
# Public key derived from CP's BOOTSTRAP_CONFIG_SIGNING_KEY (64 hex chars).
MANAGED_CP_CONFIG_PUBLIC_KEY=replace-with-the-64-character-hex-public-key
# One-time token issued for this single managed client artifact.
MANAGED_BOOTSTRAP_TOKEN=replace-with-a-single-use-bootstrap-token
