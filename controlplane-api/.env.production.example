CONTROL_PLANE_DOMAIN=control.example.com
DATABASE_URL=postgres://rustdesk:replace-with-a-long-random-password@postgres:5432/rustdesk_cp
BOOTSTRAP_TOKEN=replace-with-a-long-random-bootstrap-token
SESSION_TTL_HOURS=24
SESSION_COOKIE_SECURE=true
DEVICE_CREDENTIAL_SIGNING_KEY=replace-with-a-64-character-hex-seed
BOOTSTRAP_CONFIG_SIGNING_KEY=replace-with-a-different-64-character-hex-seed
TOTP_ENCRYPTION_KEY=replace-with-a-64-character-hex-key
RUST_LOG=info,control_plane_api=info
